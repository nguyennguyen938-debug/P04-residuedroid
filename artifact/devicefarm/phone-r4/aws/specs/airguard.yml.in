# Round 4 on AWS Device Farm: AirGuard lifecycle, stock/fenced/layered in every trial (card ../../card-airguard-phone.md,
# adapted by B). campaign_airguard.py --phone (airguard-phone.patch, applied in the package): run-as reads, sink ports
# 8795-8797 through adb reverse. Generated by make_spec.sh.
# @SCHED@ = pending,kill,netloss | reboot (separate jobs, as for the lifecycle run).
version: 0.1
android_test_host: amazon_linux_2

phases:
  install:
    commands:
      - devicefarm-cli use python 3.12
      - python3 --version
      - adb version
  pre_test:
    commands:
      - adb -s $DEVICEFARM_DEVICE_UDID shell getprop ro.build.fingerprint
      # the uploaded app (airguard-fenced.apk) is pre-installed by Device Farm; the harness installs all three itself
      - adb -s $DEVICEFARM_DEVICE_UDID uninstall de.seemoo.at_tracking_detection.p04fenced; echo "UNINSTALL_EXIT=$?"
  test:
    commands:
      - cd $DEVICEFARM_TEST_PACKAGE_PATH
      - ADB=adb python3 artifact/followup/campaign_airguard.py --serial $DEVICEFARM_DEVICE_UDID --apkdir artifact/realapp/airguard/build/phone --phone --variants stock,fenced,layered --schedules @SCHED@ --start @START@ --trials @N@ --seed airguard-df-20261125 --out $DEVICEFARM_LOG_DIR/airguard; echo "AIRGUARD_EXIT=$?"
  post_test:
    commands:
      - adb -s $DEVICEFARM_DEVICE_UDID reverse --remove-all || true
      - for v in stock fenced layered; do adb -s $DEVICEFARM_DEVICE_UDID uninstall de.seemoo.at_tracking_detection.p04$v || true; done

artifacts:
  - $DEVICEFARM_LOG_DIR
